#RewriteEngine On


#RewriteCond %{HTTPS} off [OR]
#RewriteCond %{HTTP_HOST} ^www\. [NC]
#RewriteRule ^ https://slashkode.com.au%{REQUEST_URI} [L,R=301]

# Serve .php files without the extension in the URL
RewriteEngine On

RewriteRule ^services/?$ services.php [L]

RewriteCond %{REQUEST_FILENAME}.php -f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ $1.php [L]

# Redirect any direct .php requests to the clean URL (avoids duplicate content)
RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Stop raw directory listings if a folder has no index file
Options -Indexes